{
  "name": "telegram-ai-support",
  "version": "1.0.0",
  "private": true,
  "description": "Production Telegram Business AI support with grounded RAG and durable human handoff",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,mini-app -c blue,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/main.js",
    "worker": "tsx src/worker.ts",
    "worker:start": "node dist/worker.js",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build:web --silent && vitest run",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "node dist/cli/prisma-seed.js",
    "mysql:setup": "tsx src/cli/mysql-setup.ts",
    "qdrant:init": "tsx src/cli/qdrant-init.ts",
    "qdrant:reindex": "tsx src/cli/qdrant-reindex.ts",
    "telegram:set-webhooks": "tsx src/cli/telegram-set-webhooks.ts",
    "telegram:delete-webhooks": "tsx src/cli/telegram-delete-webhooks.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/sensible": "6.0.4",
    "@hookform/resolvers": "^5.2.1",
    "@prisma/client": "6.19.3",
    "@qdrant/js-client-rest": "1.18.0",
    "@tanstack/react-query": "^5.85.5",
    "fastify": "5.11.0",
    "openai": "7.3.0",
    "pino": "10.3.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "4.1.0",
    "concurrently": "^9.2.1",
    "eslint": "10.0.2",
    "jsdom": "^26.1.0",
    "prettier": "3.9.6",
    "prisma": "6.19.3",
    "tsx": "4.23.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "^7.1.3",
    "vitest": "4.1.0"
  }
}
