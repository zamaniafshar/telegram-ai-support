NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=https://support.example.com
MINI_APP_URL=https://support.example.com/mini-app
LOG_LEVEL=info
LOG_PERSONAL_DATA=false
SHUTDOWN_TIMEOUT_MS=10000

DATABASE_URL=mysql://support_user:replace-me@127.0.0.1:3306/telegram_ai_support

TELEGRAM_BUSINESS_BOT_TOKEN=000000:replace-with-business-bot-token
TELEGRAM_BUSINESS_WEBHOOK_SECRET=replace_with_independent_random_secret_0001
TELEGRAM_BUSINESS_WEBHOOK_PATH=/webhooks/telegram/business
TELEGRAM_ADMIN_BOT_TOKEN=000000:replace-with-admin-bot-token
TELEGRAM_ADMIN_WEBHOOK_SECRET=replace_with_independent_random_secret_0002
TELEGRAM_ADMIN_WEBHOOK_PATH=/webhooks/telegram/admin
TELEGRAM_OWNER_ID=123456789
TELEGRAM_INITIAL_ADMIN_IDS=
TELEGRAM_MARK_READ=false
TELEGRAM_TRANSPORT=webhook
MINI_APP_AUTH_MAX_AGE_SECONDS=300
MINI_APP_SESSION_HOURS=8
# Development only: active Admin Telegram ID for localhost browser preview.
# MINI_APP_DEV_ADMIN_ID=123456789
BUSINESS_DEFAULT_TIMEZONE=Asia/Tehran

OPENAI_API_KEY=replace-with-nanogpt-key
OPENAI_BASE_URL=https://nano-gpt.com/api/v1
OPENAI_CHAT_MODEL=replace-with-chat-model
OPENAI_EMBEDDING_MODEL=replace-with-embedding-model
OPENAI_EMBEDDING_DIMENSIONS=0
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT_MS=30000
NANOGPT_BALANCE_URL=https://nano-gpt.com/api/check-balance
NANOGPT_LOW_BALANCE_USD=3
NANOGPT_BALANCE_CHECK_INTERVAL_HOURS=24
NANOGPT_INSUFFICIENT_ALERT_COOLDOWN_HOURS=24

QDRANT_URL=https://replace-with-cluster.example
QDRANT_API_KEY=
QDRANT_COLLECTION=telegram_support_knowledge
QDRANT_TIMEOUT_MS=600000

RETRIEVAL_MIN_SCORE=0.72
RETRIEVAL_LIMIT=8
CONVERSATION_CONTEXT_MESSAGES=8
SAFE_GREETING_ENABLED=true
MAX_CUSTOMER_MESSAGE_LENGTH=8000
MAX_KNOWLEDGE_TITLE_LENGTH=200
MAX_KNOWLEDGE_DESCRIPTION_LENGTH=100000
CHUNK_MAX_CHARS=1800
CHUNK_OVERLAP_CHARS=250
MESSAGE_DEBOUNCE_MS=1200
AI_CUSTOMER_MAX_REQUESTS_PER_HOUR=10
AI_CUSTOMER_MAX_REQUESTS_PER_DAY=30
AI_CUSTOMER_COOLDOWN_MINUTES=360
AI_BUSINESS_MAX_REQUESTS_PER_HOUR=100
AI_BUSINESS_MAX_REQUESTS_PER_DAY=500
AI_BUSINESS_COOLDOWN_MINUTES=60
AI_MAX_BATCH_MESSAGES=20
AI_MAX_BATCH_CHARS=12000

HANDOFF_HOURS=24
TELEGRAM_REPLY_WINDOW_HOURS=24
HANDOFF_CUSTOMER_MESSAGE=برای پاسخ دقیق‌تر، گفت‌وگوی شما به پشتیبانی انسانی ارجاع داده شد.
HANDOFF_CUSTOMER_MESSAGE_ENABLED=false
ADMIN_NOTIFY_ADDITIONAL_MESSAGES=false
AI_ANALYTICS_RETENTION_DAYS=90
# Optional model pricing used only for analytics cost estimates.
# AI_INPUT_COST_PER_MILLION_USD=0
# AI_OUTPUT_COST_PER_MILLION_USD=0

WORKER_POLL_INTERVAL_MS=1500
WORKER_BATCH_SIZE=10
JOB_LEASE_MS=120000
INDEXING_MAX_ATTEMPTS=6
INDEXING_BACKOFF_BASE_MS=5000
RUN_WORKERS_IN_API=true

TRUST_PROXY=false
WEBHOOK_RATE_LIMIT_MAX=300
WEBHOOK_RATE_LIMIT_WINDOW=1 minute

SEED_BUSINESS_ACCOUNT_ID=00000000-0000-4000-8000-000000000001
SEED_BUSINESS_ACCOUNT_NAME=پشتیبانی
